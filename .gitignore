# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
# settings.local.json contains secrets (API tokens) — never commit
.claude/settings.local.json
# .claude/skills symlinks are machine-specific absolute paths, recreated by `npx skills add`
.claude/skills/

# local-only skills (installed via `npx skills`, kept on disk, not tracked in git)
.agents/
.agent/
skills-lock.json

.mcp.json
