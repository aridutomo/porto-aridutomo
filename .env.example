# Web3Forms access key — powers the contact form so messages are emailed
# directly to sosial.aridutomo@gmail.com without opening a mail client.
#
# How to get one (free):
#   1. Go to https://web3forms.com
#   2. Enter sosial.aridutomo@gmail.com and submit
#   3. Copy the access key from the confirmation email
#
# Copy this file to `.env.local` for local dev:
#   cp .env.example .env.local
# then paste your key below.
#
# For VPS deploy: set the same variable in your environment before `next build`
# / `next start` (e.g. export in systemd unit, .bashrc, or docker env).
#
# NOTE: this key is intentionally public (NEXT_PUBLIC_*) — Web3Forms keys are
# safe to expose client-side. Lock it down by whitelisting your domain in the
# Web3Forms dashboard to prevent abuse.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key-here
